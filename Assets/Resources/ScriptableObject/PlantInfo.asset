      KEYWORD: "\u68A6\u5883\u7B49\u7EA7\uFF1A\u539F\u7248\u690D\u7269\r\n\u690D\u7269\u7C7B\u578B\uFF1A\u7070\u70EC\u690D\u7269\r\n\u82B1\u8D39\uFF1A25\u9633\u5149\r\n\u51B7\u5374\uFF1A30\u79D2\r\n\u751F\u547D\uFF1A300\r\n\u5A01\u529B\uFF1A1800\r\n\u8303\u56F4\uFF1A\u672C\u683C\r\n\u68A6\u5883\u6DF1\u5EA6\uFF1A--"
      Characteristic: "\u7279\u6027\uFF1A\u79CD\u690D15\u79D2\u540E\u51FA\u571F\uFF0C\u63A5\u89E6\u50F5\u5C38\u540E\u5BF9\u672C\u683C\u6240\u6709\u50F5\u5C38\u9020\u62101800\u70B9\u65E0\u89C6\u9632\u5177\u4F24\u5BB3"
      Description: "\u4E00\u4E9B\u4EBA\u8BF4\u571F\u8C46\u96F7\u5F88\u61D2\uFF0C\u56E0\u4E3A\u4ED6\u603B\u662F\u628A\u6240\u6709\u4E8B\u60C5\u7559\u5230\u6700\u540E\u3002\u571F\u8C46\u96F7\u624D\u6CA1\u7A7A\u7406\u4ED6\u4EEC\uFF0C\u4ED6\u6B63\u5FD9\u7740\u8003\u8651\u4ED6\u7684\u6295\u8D44\u6218\u7565\u5462\u3002"
      FirstShow: "\u654C\u4EBA\u63A5\u89E6\u540E\u7206\u70B8, \u4F46\u9700\u8981\u65F6\u95F4\u5B89\u653E\u3002"
