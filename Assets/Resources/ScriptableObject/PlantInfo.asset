      KEYWORD: "\u68A6\u5883\u7B49\u7EA7\uFF1A\u539F\u7248\u690D\u7269\r\n\u690D\u7269\u7C7B\u578B\uFF1A\u7070\u70EC\u690D\u7269\r\n\u82B1\u8D39\uFF1A150\u9633\u5149\r\n\u51B7\u5374\uFF1A50\u79D2\r\n\u751F\u547D\uFF1A300\r\n\u5A01\u529B\uFF1A1800\r\n\u8303\u56F4\uFF1A3*3\u683C\r\n\u68A6\u5883\u6DF1\u5EA6\uFF1A--"
      Characteristic: "\u7279\u6027\uFF1A\u79CD\u690D\u540E\u7206\u70B8\uFF0C\u5BF9\u534A\u5F841.5\u683C\u5185\u7684\u6240\u6709\u50F5\u5C38\u9020\u62101800\u70B9\u7070\u70EC\u4F24\u5BB3"
      Description: "\u201C\u6211\u8981\u2018\u7206\u2019\u5F00\u4E86\uFF0C\u201D\u6A31\u6843\u4E00\u53F7\u8BF4\u3002\u201C\u4E0D\uFF0C\u6211\u4EEC\u662F\u8981\u2018\u70B8\u2019\u5F00\u4E86\uFF01\u201D\u5B83\u54E5\u54E5\u6A31\u6843\u4E8C\u53F7\u8BF4\u3002\u7ECF\u8FC7\u6FC0\u70C8\u7684\u5546\u8BAE\u4E4B\u540E\uFF0C\u5B83\u4EEC\u624D\u7EDF\u4E00\u8FBE\u6210\u201C\u7206\u70B8\u201D\u8FD9\u4E2A\u8BF4\u6CD5\u3002"
      FirstShow: "\u70B8\u6389\u4E00\u5B9A\u533A\u57DF\u5185\u7684\u6240\u6709\u50F5\u5C38\u3002"
