      Characteristic: "\u7279\u6027\uFF1A\u6BCF\u6B21\u653B\u51FB\u65F6\u53D1\u5C04\u5149\u660E\u8C4C\u8C46\u5B50\u5F39\u6216\u6697\u5F71\u8C4C\u8C46\u5B50\u5F39\uFF0C\u53D1\u5C04\u5149\u660E\u8C4C\u8C46/\u6697\u5F71\u8C4C\u8C46\u5B50\u5F39\u540E\u81EA\u8EAB\u589E\u52A0/\u51CF\u5C111\u70B9\u65E5\u6708\u503C\u3002\u5F53\u65E5\u6708\u503C\u8FBE\u523010/-10\u65F6\u81EA\u8EAB\u8FDB\u5165\u201C\u5149\u534E\u201D/\u201C\u6708\u534E\u201D\u72B6\u6001\uFF0C\u81EA\u8EAB\u56FA\u5B9A\u53D1\u5C04\u5149\u660E\u8C4C\u8C46/\u6697\u5F71\u8C4C\u8C46\u5B50\u5F39\uFF0C\u4E14\u81EA\u8EAB\u4E0D\u53D7\u81EA\u8EAB\u5149\u73AF\u8D1F\u9762\u72B6\u6001\u5F71\u54CD\uFF0C\u6301\u7EED10\u79D2\uFF0C\u72B6\u6001\u7ED3\u675F\u540E\u65E5\u6708\u503C\u91CD\u8BBE\u4E3A0\r\n\u672F\u9635\uFF1A3*3\u8303\u56F4\u5185\u6BCF\u67091\u682A\u5149\u5143\u7D20/\u6697\u5143\u7D20\u690D\u7269\u4FBF\u4F7F\u81EA\u8EAB\u53D1\u5C04\u5149\u660E\u8C4C\u8C46/\u6697\u5F71\u8C4C\u8C46\u5B50\u5F39\u6982\u7387+2%
        \r\n\u5149\u73AF\uFF1A\u5168\u573A\u5149\u5143\u7D20\u690D\u7269\u901F\u5EA6-10%\uFF0C\u653B\u51FB\u529B+15%\uFF1B\u5168\u573A\u6697\u5143\u7D20\u690D\u7269\u901F\u5EA6+15%\uFF0C\u653B\u51FB\u529B-10%"
      Description: "\u201C\u65E5\u6708\u53CC\u53D1\u5C04\u624B\u7684\u5DEB\u5E08\u5E3D\u662F\u4E3A\u4E86\u63A9\u76D6\u4ED6\u90AA\u6076\u884C\u4E3A\u7684\u75D5\u8FF9\u3002\u4ED6\u5176\u5B9E\u662F\u5149\u5143\u7D20\u7684\u660E\u8C4C\u8C46\u5C04\u624B\u541E\u566C\u4E86\u6697\u5143\u7D20\u5143\u7D20\u7684\u8C4C\u8C46\u5C04\u624B\uFF0C\u4F60\u770B\u540D\u5B57\u5C31\u77E5\u9053\u4ED6\u5403\u80D6\u4E86\u3002\u201D\u6708\u8680\u80C6\u5C0F\u83C7\u7684\u8111\u6D1E\u6545\u4E8B\u662F\u8FD9\u6837\u8BB2\u7684\uFF0C\u5C3D\u7BA1\u5DEB\u5E08\u5E3D\u53EA\u662F\u4ED6\u7684\u7761\u8863\u3002"
      FirstShow: "\u5149\u6697\u4EA4\u878D\uFF0C\u65E5\u6708\u751F\u8F89\u3002"
