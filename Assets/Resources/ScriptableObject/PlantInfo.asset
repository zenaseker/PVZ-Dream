    plantDescribe:
      Name: "\u8C4C\u8C46\u5C04\u624B"
      MiniInfo: "\u8C4C\u8C46\u5C04\u624B\uFF0C\u4F60\u7684\u7B2C\u4E00\u9053\u9632\u7EBF\u3002\u5B83\u4EEC\u901A\u8FC7\u53D1\u5C04\u8C4C\u8C46\u6765\u653B\u51FB\u50F5\u5C38\u3002\u5411\u654C\u4EBA\u5C04\u51FA\u8C4C\u8C46\u3002"
      KEYWORD: "\u68A6\u5883\u7B49\u7EA7\uFF1A\u539F\u7248\u690D\u7269\r\n\u690D\u7269\u7C7B\u578B\uFF1A\u8FDB\u653B\u690D\u7269\r\n\u82B1\u8D39\uFF1A100\u9633\u5149\r\n\u51B7\u5374\uFF1A7.5\u79D2\r\n\u751F\u547D\uFF1A300\r\n\u5A01\u529B\uFF1A20/1.4s\r\n\u8303\u56F4\uFF1A\u524D\u65B9\u6574\u884C\r\n\u68A6\u5883\u6DF1\u5EA6\uFF1A--"
      Characteristic: "\u7279\u6027\uFF1A\u6BCF1.4\u79D2\u5411\u524D\u53D1\u5C04\u4E00\u679A\u8C4C\u8C46\u5B50\u5F39"
      Description: "\u4E00\u68F5\u690D\u7269\uFF0C\u600E\u4E48\u80FD\u5982\u6B64\u5FEB\u5730\u751F\u957F\uFF0C\u5E76\u53D1\u5C04\u5982\u6B64\u591A\u7684\u8C4C\u8C46\u5462\uFF1F\u8C4C\u8C46\u5C04\u624B\uFF1A\u201C\u52AA\u529B\u5DE5\u4F5C\uFF0C\u5949\u732E\u81EA\u5DF1\uFF0C\u518D\u52A0\u4E0A\u4E00\u4EFD\u9633\u5149\uFF0C\u9AD8\u7EA4\u7EF4\u548C\u6C27\u5316\u78B3\u5747\u8861\u642D\u914D\uFF0C\u8FD9\u79CD\u5065\u5EB7\u65E9\u9910\u8BA9\u4E00\u5207\u6210\u4E3A\u53EF\u80FD\u3002\u201D"
      FirstShow: "\u5411\u654C\u4EBA\u5C04\u51FA\u8C4C\u8C46\u3002"
