      KEYWORD: "\u68A6\u5883\u7B49\u7EA7\uFF1A\u539F\u7248\u690D\u7269\r\n\u690D\u7269\u7C7B\u578B\uFF1A\u7070\u70EC\u690D\u7269\r\n\u82B1\u8D39\uFF1A125\u9633\u5149\r\n\u51B7\u5374\uFF1A50\u79D2\r\n\u751F\u547D\uFF1A300\r\n\u5A01\u529B\uFF1A1800\r\n\u8303\u56F4\uFF1A\u534A\u5F843.5\u683C\r\n\u68A6\u5883\u6DF1\u5EA6\uFF1A--"
      Characteristic: "\u7279\u6027\uFF1A\u767D\u5929\u4F1A\u7761\u89C9\u3002\u7206\u70B8\u540E\u4F1A\u5728\u539F\u5730\u7559\u4E0B\u4E00\u4E2A\u7206\u70B8\u5751\uFF0C\u5751\u5185\u65E0\u6CD5\u683D\u79CD\u4EFB\u4F55\u690D\u7269\uFF0C\u6301\u7EED180S\u3002"
