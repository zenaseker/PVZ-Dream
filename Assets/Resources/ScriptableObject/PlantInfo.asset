    plantDescribe:
      Name: "\u5411\u65E5\u8475"
      MiniInfo: "\u4E3A\u4F60\u751F\u4EA7\u989D\u5916\u9633\u5149\u7684\u7ECF\u6D4E\u4F5C\u7269\u3002\u5C1D\u8BD5\u5C3D\u53EF\u80FD\u591A\u7684\u79CD\u690D\u5427\uFF01"
      KEYWORD: "\u68A6\u5883\u7B49\u7EA7\uFF1A\u539F\u7248\u690D\u7269\r\n\u690D\u7269\u7C7B\u578B\uFF1A\u751F\u4EA7\u690D\u7269\r\n\u82B1\u8D39\uFF1A50\u9633\u5149\r\n\u51B7\u5374\uFF1A7.5\u79D2\r\n\u751F\u547D\uFF1A300\r\n\u5A01\u529B\uFF1A--\r\n\u8303\u56F4\uFF1A--\r\n\u68A6\u5883\u6DF1\u5EA6\uFF1A--"
      Characteristic: "\u7279\u6027\uFF1A\u6BCF24\u79D2\u751F\u4EA71\u5355\u4F4D\u9633\u5149(25\u9633\u5149)"
      Description: "\u5411\u65E5\u8475\u60C5\u4E0D\u81EA\u7981\u5730\u548C\u7740\u8282\u62CD\u8D77\u821E\u3002\u662F\u4EC0\u4E48\u8282\u62CD\u5462\uFF1F\u55E8\uFF0C\u662F\u5927\u5730\u81EA\u5DF1\u7528\u6765\u63D0\u795E\u7684\u7235\u58EB\u8282\u62CD\uFF0C\u8FD9\u79CD\u9891\u7387\u7684\u8282\u62CD\uFF0C\u53EA\u6709\u5411\u65E5\u8475\u624D\u80FD\u542C\u5230\u3002"
      FirstShow: "\u63D0\u4F9B\u4F60\u989D\u5916\u7684\u9633\u5149\u3002"
