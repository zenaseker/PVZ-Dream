      Characteristic: "\u7279\u6027\uFF1A\u6BCF1.4\u79D2\u5411\u524D\u53D1\u5C04\u4E00\u679A\u5BD2\u51B0\u8C4C\u8C46\u5B50\u5F39\uFF0C\u51FB\u4E2D\u50F5\u5C38\u65F6\u5BF9\u5176\u65BD\u52A02\u7EA7<link><size=+3><b><u>\u5BD2\u51B7</b></u></size></link>10\u79D2"
      Description: "\u4EBA\u4EEC\u7ECF\u5E38\u544A\u8BC9\u5BD2\u51B0\u5C04\u624B\u4ED6\u662F\u591A\u4E48\u201C\u51B7\u9177\u201D\uFF0C\u6216\u8005\u544A\u8BEB\u4ED6\u8981\u201C\u51B7\u9759\u201D\u3002\u4ED6\u4EEC\u53EB\u4ED6\u8981\u201C\u4FDD\u6301\u9547\u9759\u201D\u5BD2\u51B0\u5C04\u624B\u53EA\u662F\u8F6C\u8F6C\u4ED6\u7684\u773C\u775B\uFF0C\u5176\u5B9E\u4ED6\u90FD\u542C\u89C1\u4E86\u3002"
      FirstShow: "\u5BD2\u51B0\u5C04\u624B\u53EF\u9020\u6210\u4F24\u5BB3, \u540C\u65F6\u53C8\u6709\u51CF\u901F\u6548\u679C\u3002"
